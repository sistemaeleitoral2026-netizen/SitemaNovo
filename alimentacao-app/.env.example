VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Servidor (Vercel). Sem prefixo VITE_, para a chave não ir no site.
GABINETE_SUPABASE_URL=https://your-gabinete-project.supabase.co
GABINETE_SERVICE_ROLE_KEY=

# Leitura pública das proposições (só a anon key).
VITE_GABINETE_URL=https://your-gabinete-project.supabase.co
VITE_GABINETE_ANON_KEY=

# Chat Seguro (/chat) — notificações push. Gere com: node build-checks/chat-seguro/gen-vapid-chat.mjs
VITE_CHAT_VAPID_PUBLIC_KEY=
# Só na Vercel (servidor): CHAT_VAPID_PUBLIC_KEY, CHAT_VAPID_PRIVATE_KEY, CHAT_VAPID_SUBJECT, CHAT_WEBHOOK_SECRET
