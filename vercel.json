{
  "framework": "vite",
  "installCommand": "npm install --prefix alimentacao-app",
  "buildCommand": "npm run build --prefix alimentacao-app",
  "outputDirectory": "alimentacao-app/dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
