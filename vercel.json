{
  "framework": "vite",
  "installCommand": "npm install --prefix alimentacao-app",
  "buildCommand": "npm run build --prefix alimentacao-app",
  "outputDirectory": "alimentacao-app/dist",
  "functions": {
    "api/folha-cron.js": {
      "maxDuration": 60
    },
    "api/gabinete.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/folha-cron", "schedule": "0 12 * * *" }
  ],
  "headers": [
    {
      "source": "/sistemas/chat-seguro/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; frame-ancestors 'self'; form-action 'none'; base-uri 'none'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=(), payment=()" }
      ]
    },
    {
      "source": "/sistemas/chat-seguro/(index.html|sw.js|app.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/api/chat-(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/|sistemas/).*)",
      "destination": "/index.html"
    }
  ]
}
