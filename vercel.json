{
  "framework": "vite",
  "installCommand": "npm install --prefix alimentacao-app",
  "buildCommand": "npm run build --prefix alimentacao-app",
  "outputDirectory": "alimentacao-app/dist",
  "functions": {
    "api/folha-cron.js": {
      "maxDuration": 60
    },
    "api/gabinete.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/|assessoria-mb/|painel-do-mandato/).*)",
      "destination": "/index.html"
    }
  ]
}
